acl "trusted" {
    127.0.0.1;
    192.168.56.0/24;
};

options {

    directory "/var/cache/bind";

    recursion yes;

    allow-recursion {
        trusted;
    };

    allow-query-cache {
        trusted;
    };

    allow-query {
        any;
    };

    allow-transfer {
        none;
    };

    version none;

    minimal-responses yes;

    dnssec-validation auto;

    rate-limit {
        responses-per-second 5;
        window 5;
    };

    max-cache-size 100M;
    max-cache-ttl 3600;
    max-ncache-ttl 3600;

    listen-on {
        any;
    };

    listen-on-v6 {
        none;
    };
};
